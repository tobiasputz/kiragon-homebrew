    {
      "id": "regret",
      "actor": {
        "name": "Grasping Regret",
        "type": "npc",
        "img": "icons/svg/mystery-man.svg",
        "prototypeToken": {
          "name": "Grasping Regret",
          "displayName": 30,
          "disposition": -1,
